{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkansasio.github.io/uml-whitebord/uml-studio/blueprint.schema.json",
  "title": "MLTA UML Blueprint",
  "description": "Portable UML Studio blueprint interchange format version 1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "class",
              "interface",
              "package",
              "component",
              "usecase",
              "actor",
              "database",
              "note",
              "state"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "members": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "w": {
            "type": "number",
            "minimum": 80,
            "maximum": 600
          },
          "h": {
            "type": "number",
            "minimum": 50,
            "maximum": 500
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "association",
              "dependency",
              "inheritance",
              "composition",
              "aggregation"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
